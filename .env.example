# ─────────────────────────────────────────────────────────────
# Looply — environment template (development / Demo V1)
# Copy to `.env` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection. Used by Prisma + backend runtime.
# NOTE: a PostgreSQL server is running on localhost:5432 and a `looply`
# role exists, but its password was not discoverable in this environment.
# Set the real password here once provisioned.
DATABASE_URL="postgresql://looply:CHANGE_ME@localhost:5432/looply?schema=public"

# Backend
PORT=4000
NODE_ENV=development

# Allowed browser origin for the SPA (CORS + CSRF origin guard). Must match the
# frontend's real origin. Wildcard `*` is rejected by validateEnv.
CORS_ORIGIN=http://localhost:5173

# Public frontend origin used to build client approval links (/approve/:token)
# and password-reset links. Read by env.ts (PUBLIC_APP_URL) and mailService.ts
# (FRONTEND_URL -> APP_URL -> PUBLIC_APP_URL).
PUBLIC_APP_URL=http://localhost:5173

# Seed credentials (backend/src/seed.ts). REQUIRED to run the seed — there is
# NO hardcoded fallback; the seed fails explicitly if either is missing.
# Replace SEED_ADMIN_PASSWORD with a real value (never commit it).
SEED_ADMIN_EMAIL=admin@looply.dev
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD

# Frontend (Vite) — API base URL for the internal SPA. Leave empty ("") to use
# the dev proxy (Vite proxies /api -> backend). Override for a remote API.
VITE_API_URL=http://localhost:4000

# Private S3-compatible object storage (B8). Required before enabling file
# routes in a deployed environment. Never commit real credentials.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
# Browser-reachable base used ONLY for presigned URL generation. Browser PUTs
# land on this origin, and Nginx must proxy that exact path verbatim to MinIO
# so the SigV4 canonical request matches what the presigner signed.
# Path-style example: https://looply.verbumlab.com.br  (paired with an
# Nginx location that proxies /<bucket>/ to the internal MinIO endpoint).
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PRESIGN_TTL_SECONDS=600

# Set true only when the app is behind the single trusted HTTPS reverse proxy.
TRUST_PROXY=false

# Demo/mock switches (default false). DEMO_MODE activates demoGuard (403 on
# password/role/workflow mutations) and the mock WhatsApp provider; MOCK_PROVIDER
# swaps the WhatsApp transport for a no-op fake. Dev/test only — validateEnv
# refuses either flag when NODE_ENV=production.
DEMO_MODE=false
MOCK_PROVIDER=false

# Optional structured natural-language Assistant provider (OpenAI-compatible).
# Leave unset to keep /api/assistant/messages unavailable without affecting A2.
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
# Optional multi-provider fallback: a JSON array of extra OpenAI-compatible
# providers, tried IN ORDER when the primary above fails (rate limit / outage).
# Leave empty to keep today's single-provider behavior. Best model first.
# ASSISTANT_LLM_FALLBACKS=[{"baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-...","model":"deepseek-chat"},{"baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","apiKey":"...","model":"gemini-2.0-flash"}]
ASSISTANT_LLM_FALLBACKS=

# Audio transcription provider (OpenAI-compatible / Groq Whisper / etc.).
# Optional — falls back to ASSISTANT_LLM_* when unset for backward compatibility.
AUDIO_TRANSCRIPTION_BASE_URL=
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=
# Groq example:
# AUDIO_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Shared transient state (Assistant confirmations + webhook idempotency).
# Required before A3.1 WhatsApp processing; unset means state layer is
# unavailable and Assistant WhatsApp commands must fail closed. Never log it.
REDIS_URL=

# WhatsApp Cloud API (Meta) transport for the Assistant (A3.1). Required
# before /api/webhooks/whatsapp accepts traffic; inbound needs VERIFY_TOKEN +
# APP_SECRET (signature), outbound needs ACCESS_TOKEN + PHONE_NUMBER_ID.
# Never log or commit these values.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID — required for management API (list phone
# numbers, list/send message templates). Found in Business Manager > WhatsApp
# Accounts or the Meta App Dashboard.
WHATSAPP_WABA_ID=

# Gupshup official WhatsApp transport for the Assistant (A3.G1). Optional —
# Meta-only environments remain valid when unset. Gupshup inbound FAILS CLOSED
# unless GUPSHUP_WEBHOOK_IP_ALLOWLIST is set: Gupshup Self-Serve webhooks have
# no cryptographic signature, so the documented authenticity boundary is IP
# allowlisting (request inbound IPs from devsupport@gupshup.io). Outbound
# replies need API_KEY + APP_NAME + SOURCE_NUMBER. Never log or commit these.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
# Comma-separated IPs/CIDRs allowed to POST the Gupshup webhook.
GUPSHUP_WEBHOOK_IP_ALLOWLIST=

# ─────────────────────────────────────────────────────────────
# Email delivery (Resend) — password-reset mail (A4.x). The backend
# ResendMailService falls back to SIMULATION (logs, returns simulated) when
# RESEND_API_KEY is unset or "disabled". Real delivery requires:
#  - a valid Resend API key (never commit it),
#  - a verified sending domain matching RESEND_FROM's domain,
#  - PUBLIC_APP_URL (or FRONTEND_URL/APP_URL) for the reset link base.
# Never log or commit RESEND_API_KEY.
RESEND_API_KEY=
# Sender "Name <no-reply@your-verified-domain>". Default when unset:
# "Looply <acesso@auth.verbumlab.com.br>".
RESEND_FROM=
# Reply-to address. Default when unset: suporte@verbumlab.com.br
RESEND_REPLY_TO=
# Reset-link base reuses PUBLIC_APP_URL (see above). No separate APP_PUBLIC_URL
# consumer exists in the code.
