# ─────────────────────────────────────────────────────────────
# Looply — environment template (development / Demo V1)
# Copy to `.env` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection. Used by Prisma + backend runtime.
# NOTE: a PostgreSQL server is running on localhost:5432 and a `looply`
# role exists, but its password was not discoverable in this environment.
# Set the real password here once provisioned.
DATABASE_URL="postgresql://looply:CHANGE_ME@localhost:5432/looply?schema=public"

# Backend
PORT=4000
NODE_ENV=development

# Development demo login: `admin@looply.dev` / `looply123` (seed).
# Real session auth (B2) — no bypass flag anymore.

# Frontend (Vite) — API base URL for the internal SPA.
VITE_API_URL=http://localhost:4000

# Private S3-compatible object storage (B8). Required before enabling file
# routes in a deployed environment. Never commit real credentials.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PRESIGN_TTL_SECONDS=600

# Set true only when the app is behind the single trusted HTTPS reverse proxy.
TRUST_PROXY=false

# Optional structured natural-language Assistant provider (OpenAI-compatible).
# Leave unset to keep /api/assistant/messages unavailable without affecting A2.
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=

# Shared transient state (Assistant confirmations + webhook idempotency).
# Required before A3.1 WhatsApp processing; unset means state layer is
# unavailable and Assistant WhatsApp commands must fail closed. Never log it.
REDIS_URL=
