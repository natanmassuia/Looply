// Looply — Demo V1 schema (single-tenant)
// Run: prisma validate / prisma generate (no DB needed)
//       prisma migrate dev (needs DATABASE_URL)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CONTENT_MANAGER
  EDITOR
  SOCIAL_MEDIA
  DESIGNER
}

// Company membership role (multi-tenant authorization).
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// Workspace operational profile. Chosen during onboarding (B4);
// null = workspace provisioned but not yet configured.
enum WorkspaceTemplate {
  LOCAL_BUSINESS
  HIGH_TICKET
  MARKETING_AGENCY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ContentFormat {
  POST
  REELS
  STORY
  CAROUSEL
  VIDEO
  IMAGE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  AWAITING_CLIENT
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

// ── Models ─────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  role               UserRole @default(EDITOR)
  avatarUrl          String?
  active             Boolean  @default(true)
  passwordHash       String?  // null until the user sets a password (demo users)
  mustChangePassword Boolean  @default(false) // true after provisioning/invite temp credential
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // content this user is responsible for
  responsibleFor Content[]   @relation("ContentResponsible")
  createdBy      Content[]   @relation("ContentCreator")
  versions       ContentVersion[]
  memberships    CompanyMember[]
  sessions       Session[]
  invitationsSent Invitation[] @relation("InvitationInviter")
}

// Tenant / workspace. Resources (Client, Content, ...) are NOT yet bound to
// Company — that lands per domain battery (B4/B5+).
model Company {
  id                String           @id @default(cuid())
  name              String
  slug              String?          @unique
  workspaceTemplate WorkspaceTemplate?
  isActive          Boolean          @default(true)
  // Onboarding data (B4). onboardedAt = null until guided onboarding completes.
  legalName         String?
  document          String?
  email             String?
  phone             String?
  website           String?
  timezone          String           @default("America/Sao_Paulo")
  locale            String           @default("pt-BR")
  onboardedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  members     CompanyMember[]
  invitations Invitation[]
}

model CompanyMember {
  id         String     @id @default(cuid())
  userId     String
  companyId  String
  role       MemberRole @default(MEMBER)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

// DB-backed session. The cookie carries a random token; the row id is its
// sha256 hash, so a DB leak does not yield usable session tokens.
model Session {
  id         String    @id // sha256(token)
  userId     String
  companyId  String?   // active workspace (validated against membership)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Invitation to join a company. The token is random 256-bit; only its sha256
// (id) is stored. Single-use, expiring, revocable. No public signup exists —
// this is the only controlled path for new users besides Verbum provisioning.
model Invitation {
  id              String     @id @default(cuid()) // not the token; token is only in memory
  companyId       String
  email           String
  role            MemberRole @default(MEMBER)
  tokenHash       String     @unique // sha256(plaintext token)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  invitedBy User  @relation("InvitationInviter", fields: [invitedByUserId], references: [id])

  @@index([companyId])
  @@index([email])
}

model Client {
  id                 String       @id @default(cuid())
  name               String
  brandColor         String?
  status             ClientStatus @default(ACTIVE)
  primaryContactName String?
  primaryContactEmail String?
  primaryContactPhone String?
  channels           String[]     // e.g. ["Instagram","TikTok"]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  content Content[]

  @@unique([name])
}

model Content {
  id             String        @id @default(cuid())
  title          String
  clientId       String
  parentId       String?
  format         ContentFormat @default(POST)
  channel        String?
  responsibleId  String?
  createdById    String?
  status         ContentStatus @default(DRAFT)
  publicationTarget DateTime?   // intended pub date (editorial plan)
  scheduledAt    DateTime?      // set when SCHEDULED
  publishedAt    DateTime?      // set when PUBLISHED
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client      Client           @relation(fields: [clientId], references: [id])
  parent      Content?         @relation("ContentGroup", fields: [parentId], references: [id])
  children    Content[]        @relation("ContentGroup")
  responsible User?           @relation("ContentResponsible", fields: [responsibleId], references: [id])
  createdBy   User?           @relation("ContentCreator", fields: [createdById], references: [id])
  versions    ContentVersion[]
  approvals   Approval[]

  @@index([clientId])
  @@index([status])
  @@index([responsibleId])
  @@index([parentId])
}

model ContentVersion {
  id          String   @id @default(cuid())
  contentId   String
  versionNumber Int
  caption     String
  mediaUrl    String?
  mediaType   String?
  changeNote  String?   // internal note describing what changed vs previous version
  createdById String?
  createdAt   DateTime @default(now())

  content    Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation(fields: [createdById], references: [id])
  approvals  Approval[]

  @@unique([contentId, versionNumber])
  @@index([contentId])
}

// One row per "send for approval" round. Tied to a specific version so
// history is preserved: v1 -> changes_requested, v2 -> approved.
model Approval {
  id               String         @id @default(cuid())
  contentId        String
  contentVersionId String
  token            String         @unique // random, non-sequential (crypto)
  status           ApprovalStatus @default(PENDING)
  feedback         String?        // client change-request text
  clientName       String?
  clientReviewedAt DateTime?
  createdAt        DateTime       @default(now())

  content   Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([contentVersionId])
}
